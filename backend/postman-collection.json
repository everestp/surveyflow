{
  "info": {
    "_postman_id": "a8f4d0e1-7b32-4c91-9a21-6f3e5d8b2c10",
    "name": "SurveyFlow API",
    "description": "Complete API testing collection for SurveyFlow: authentication, survey management, public responses, and analytics.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "surveyId",
      "value": ""
    },
    {
      "key": "questionTextId",
      "value": "11111111-1111-4111-8111-111111111111"
    },
    {
      "key": "questionChoiceId",
      "value": "22222222-2222-4222-8222-222222222222"
    },
    {
      "key": "questionRatingId",
      "value": "33333333-3333-4333-8333-333333333333"
    }
  ],
  "item": [
    {
      "name": "01 - Authentication",
      "item": [
        {
          "name": "Register Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"StrongPassword123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Registration successful', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json.data && json.data.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"StrongPassword123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login successful', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json.data && json.data.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Current user retrieved', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Survey Management",
      "item": [
        {
          "name": "Create Survey",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Developer Experience Survey\",\n  \"description\": \"Help us understand your developer experience.\",\n  \"questions\": [\n    {\n      \"id\": \"{{questionTextId}}\",\n      \"title\": \"What is your name?\",\n      \"description\": \"Enter your full name.\",\n      \"type\": \"text\",\n      \"required\": true,\n      \"order\": 0\n    },\n    {\n      \"id\": \"{{questionChoiceId}}\",\n      \"title\": \"Which programming language do you prefer?\",\n      \"type\": \"single_choice\",\n      \"required\": true,\n      \"options\": [\"Go\", \"TypeScript\", \"Python\", \"Java\"],\n      \"order\": 1\n    },\n    {\n      \"id\": \"{{questionRatingId}}\",\n      \"title\": \"Rate your developer experience.\",\n      \"type\": \"rating\",\n      \"required\": true,\n      \"order\": 2\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/surveys"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Survey created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json.data && json.data.survey) {",
                  "    pm.collectionVariables.set('surveyId', json.data.survey.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get All Surveys",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/surveys?page=1&limit=10"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Surveys retrieved', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Survey By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/surveys/{{surveyId}}"
          }
        },
        {
          "name": "Update Survey",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Developer Experience Survey\",\n  \"description\": \"Updated survey description.\"\n}"
            },
            "url": "{{baseUrl}}/surveys/{{surveyId}}"
          }
        },
        {
          "name": "Publish Survey",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/surveys/{{surveyId}}/publish"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Survey published', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Survey (Draft Only)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/surveys/{{surveyId}}"
          }
        }
      ]
    },
    {
      "name": "03 - Public Responses",
      "item": [
        {
          "name": "Submit Survey Response (Public)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"respondentEmail\": \"respondent@example.com\",\n  \"answers\": [\n    {\n      \"questionId\": \"{{questionTextId}}\",\n      \"value\": \"Everest Paudel\"\n    },\n    {\n      \"questionId\": \"{{questionChoiceId}}\",\n      \"value\": \"Go\"\n    },\n    {\n      \"questionId\": \"{{questionRatingId}}\",\n      \"value\": 5\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/responses/{{surveyId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Response submitted', function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Survey Responses (Owner)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/responses/{{surveyId}}?page=1&limit=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responses retrieved', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 - Analytics",
      "item": [
        {
          "name": "Analytics Overview",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/analytics/overview"
          }
        },
        {
          "name": "Response Trend",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/analytics/responses/trend?days=30"
          }
        },
        {
          "name": "Survey Analytics",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/analytics/surveys/{{surveyId}}"
          }
        }
      ]
    },
    {
      "name": "05 - Authorization & Validation",
      "item": [
        {
          "name": "Get Current User Without Token (Expect 401)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Unauthorized request rejected', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid Login (Expect 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"WrongPassword123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invalid credentials rejected', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid Survey ID (Expect 404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/surveys/aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Unknown survey rejected', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
